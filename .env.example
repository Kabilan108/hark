# --- Website / API (apps/website) -----------------------------------------

# Public origin used in OAuth callbacks and FCM response URLs.
APP_URL=http://localhost:5173

# SQLite file. Dev default: ./data/hark.sqlite (relative to apps/website).
# Production (Docker): /data/hark.sqlite
DATABASE_URL=./data/hark.sqlite

# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth web credentials (Google Cloud Console → APIs & Services →
# Credentials → OAuth client ID, type "Web application").
# Authorized redirect URIs:
#   http://localhost:8787/api/auth/callback/google
#   https://your-tailnet-host:8443/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only this verified Google account may use the private server.
OWNER_EMAIL=

# Direct FCM HTTP v1 delivery. Keep the service-account JSON outside Git.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=/absolute/path/to/fcm-service-account.json

# Enable approvals, activities, routing, and multiple devices without Autumn.
SELF_HOSTED_MODE=true

# Webhook limits measured over a rolling 60-second window.
SERVICE_RATE_LIMIT_PER_MINUTE=60
ACCOUNT_RATE_LIMIT_PER_MINUTE=300
PRO_SERVICE_RATE_LIMIT_PER_MINUTE=300
PRO_ACCOUNT_RATE_LIMIT_PER_MINUTE=1500

# Autumn production secret key. Used only by the website server.
AUTUMN_API_KEY=

# API listener. Keep HOST on loopback when Tailscale Serve terminates HTTPS.
HOST=127.0.0.1
PORT=8787

# --- Expo app (apps/expo) ---------------------------------------------------

# HTTPS origin compiled into the Android app for API and Google OAuth requests.
EXPO_PUBLIC_API_URL=https://sietch.sole-pierce.ts.net:8443

# Firebase Android client config. Keep this file outside Git.
GOOGLE_SERVICES_JSON=/absolute/path/to/google-services.json

# Optional emulator-only inbox preview. Omit for normal registration and push.
# EXPO_PUBLIC_PREVIEW_MODE=1

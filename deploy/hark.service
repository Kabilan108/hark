[Unit]
Description=Hark Android backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/experiments/hark
ExecStart=/etc/profiles/per-user/%u/bin/direnv exec %h/experiments/hark %h/experiments/hark/scripts/start-backend
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
